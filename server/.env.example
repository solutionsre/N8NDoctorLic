# Copy to .env and fill in. Never commit .env.
#
# The code has no built-in fallback values: every setting below marked
# (required) must be set, or the server stops and lists what is missing.
#
# ADMIN PANEL: prices, trial/extension/reminder rules, payment mode + keys,
# SMTP, site name, footer and legal pages can also be edited at
# /admin → Settings (super admin). Saved admin values replace the ones here.
# Make yourself super admin once: npm run make-admin -- you@example.com

# (required) production: secure cookies, and the server refuses to start on
# unsafe settings (http/ngrok URLs, weak JWT_SECRET).
NODE_ENV=development
# (required)
PORT=5000
# (required) 0.0.0.0 = all interfaces. Behind nginx on the same machine use
# 127.0.0.1, so port 5000 is not public.
HOST=0.0.0.0
# (required) How many proxies are in front of this server (1 = nginx /
# Render / ngrok). false if visitors reach Node directly.
TRUST_PROXY=1

# (required) MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/n8n_doctor_license

# (required) Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Optional, another long random string: encrypts the payment keys and SMTP
# password saved in the admin panel (JWT_SECRET is used when empty).
# Changing it later means entering those secrets again.
SETTINGS_SECRET=

# (required) Where the React site runs (dev: Vite) and the public URL of THIS
# server (payment gateways redirect back here; in production public https).
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# (required) vendor_private_key.hex from vendor-license-tool (same key the app trusts). Check with: npm run keys
LICENSE_PRIVATE_KEY_HEX=
PRODUCT_VERSION=2.0.0

# (required) Site name (website, e-mails, payment descriptions).
APP_NAME=n8n Doctor
# (required) Every date on the website and in e-mails uses this time zone,
# and the reminder job runs on its clock. Nepal: Asia/Kathmandu.
TIMEZONE=Asia/Kathmandu
# (required) Number/date format (en-IN groups rupees as 1,00,000) and currency label.
LOCALE=en-IN
CURRENCY_LABEL=Rs.

# (required) Plans: name, length in days, price in NPR
PLAN_MONTHLY_NAME=Monthly
DAYS_MONTHLY=30
PRICE_MONTHLY=1000
PLAN_SIXMONTH_NAME=6 months
DAYS_SIXMONTH=182
PRICE_SIXMONTH=5000
PLAN_YEARLY_NAME=Yearly
DAYS_YEARLY=365
PRICE_YEARLY=9000

# (required) Free trial length in days
TRIAL_DAYS=14
# (required) Paid-only extension: days it adds, and days before expiry the button appears.
EXTEND_DAYS=3
EXTEND_WINDOW_DAYS=7
# (required) true: extension days are taken from the next paid period. false: free bonus.
EXTENSION_DEDUCTED=true
# (required) Reminder e-mails: days before expiry, and when the daily job runs (cron, in TIMEZONE).
REMINDER_DAYS=7,3,1
REMINDER_CRON=0 9 * * *

# (required) Accounts: password length, lockout after wrong passwords, e-mail codes
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
CODE_MINUTES=15
CODE_ATTEMPTS=5
RESEND_SECONDS=60
RESET_MINUTES=15

# (required) Payment mode: test (gateway sandboxes, no real money) or live.
PAYMENT_MODE=test
# Optional keys; a gateway without a key for the current mode is hidden.
# Easier to set in Admin → Settings → Payments.
# Khalti test key: test-admin.khalti.com · live key: merchant dashboard
KHALTI_TEST_KEY=
KHALTI_LIVE_KEY=
# eSewa sandbox: product code EPAYTEST with eSewa's published test secret key
# (see developer.esewa.com.np). Live: your merchant code and secret key.
ESEWA_TEST_PRODUCT_CODE=
ESEWA_TEST_SECRET=
ESEWA_LIVE_PRODUCT_CODE=
ESEWA_LIVE_SECRET=

# Optional e-mail (also in Admin → Settings → E-mail, with a "send test").
# Without SMTP, codes are only printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional footer details (also in Admin → Settings → Site & footer).
SITE_TAGLINE=
SITE_COMPANY=
SITE_SUPPORT_EMAIL=
SITE_PHONE=
SITE_ADDRESS=
